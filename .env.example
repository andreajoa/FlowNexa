META_API_VERSION=v24.0
MESSAGING_ENABLED=false

# Configure approved recurring Prices; no live billing is enabled by default.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MAP={}
# Enable only after defining free/paid access policy and validating Stripe webhooks.
BILLING_ENFORCED=false
