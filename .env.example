# Server-only settings; supply secrets through Vercel environment configuration.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
RESEND_API_KEY=
PUBLIC_BASE_URL=https://flownex.online
META_APP_ID=
META_APP_SECRET=
# Explicit signing secret for the configured Instagram webhook product; server-only.
META_WEBHOOK_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URI=https://flownex.online/api/instagram/callback
META_API_VERSION=v24.0
MESSAGING_ENABLED=false

# Configure the eight server-allowlisted prices from scripts/provision-stripe-catalog.mjs.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MAP={}
# Dedicated FlowNexa portal; does not modify another application’s default portal.
STRIPE_PORTAL_CONFIGURATION=
# Enable after live configuration and verification. Existing workspaces can keep pre-launch access.
BILLING_ENFORCED=false

# Optional immutable UTC launch cutoff, e.g. 2026-10-18T20:00:00Z.
# Workspaces created strictly before this timestamp retain pre-launch access.
BILLING_LEGACY_BEFORE=

# Facebook Pages pilot, independent from Instagram. All new sends default off.
FACEBOOK_CHANNEL_ENABLED=false
FACEBOOK_SENDS_ENABLED=false
FACEBOOK_PILOT_WORKSPACES=
FACEBOOK_MONTHLY_MESSAGE_LIMIT=1000

# Optional platform-owned OAuth apps. Without these, merchants use their own app credentials.
# Register callback: https://flownex.online/api/commerce/oauth/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
# Commerce customer verification uses TOKEN_ENCRYPTION_KEY and existing RESEND_API_KEY/RESEND_FROM.
